{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/document-metadata.schema.json",
  "title": "Governed Markdown document metadata",
  "type": "object",
  "required": [
    "id", "title", "version", "status", "recommendation", "owner",
    "reviewers", "created_at", "updated_at", "applicable_stages",
    "applicable_tools", "source_type", "evidence_level", "risk_level",
    "supersedes"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["DRAFT", "REVIEWED", "VERIFIED", "DEPRECATED", "ARCHIVED"]},
    "recommendation": {"type": "string", "enum": ["RECOMMENDED", "CONDITIONAL", "NOT_RECOMMENDED", "NOT_APPLICABLE", "PENDING"]},
    "owner": {"type": "string", "minLength": 1},
    "reviewers": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"},
    "applicable_stages": {"type": "array", "items": {"type": "string"}},
    "applicable_tools": {"type": "array", "items": {"type": "string"}},
    "source_type": {"type": "string", "enum": ["OFFICIAL", "EMPIRICAL", "INDUSTRY", "COMMUNITY", "INFERENCE", "DECISION"]},
    "evidence_level": {"type": "string", "enum": ["OFFICIAL", "EMPIRICAL", "INDUSTRY", "COMMUNITY", "INFERENCE", "DECISION"]},
    "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "supersedes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
